{
  "name": "@dariuss/voice-messages-to-text",
  "version": "1.0.1-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "valenced-plugin build",
    "build:dev": "valenced-plugin build --dev",
    "generate-index": "valenced-plugin generate-index",
    "plan-releases": "valenced-plugin plan-releases --plugins-dir plugins",
    "serve": "valenced-plugin serve",
    "lint": "biome check",
    "lint:types": "tsc -p plugins/VMTT/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.cjs",
    "publish:local": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@valenced/plugin-cli": "git+https://github.com/Valenced/valenced-plugin-cli.git#9ea9f9bfc91319e2b18c6b1c9ac0b993f8600c1d",
    "@valenced/types": "git+https://github.com/Valenced/valenced-types.git#c67dd726d1ec28b38d8ac93862fdd3b6029b1d29"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.0",
    "fflate": "^0.8.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@valenced/plugin-cli",
    "@swc/core"
  ]
